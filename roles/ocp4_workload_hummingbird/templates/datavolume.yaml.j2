---
apiVersion: cdi.kubevirt.io/v1beta1
kind: DataVolume
metadata:
  name: {{ ocp4_workload_hummingbird_datavolume_name }}
  namespace: {{ ocp4_workload_hummingbird_datavolume_namespace }}
spec:
  source:
{% if ocp4_workload_hummingbird_datavolume_s3_access_key_id | default("") | length > 0 and ocp4_workload_hummingbird_datavolume_s3_secret_access_key | default("") | length > 0 %}
    s3:
      url: {{ ocp4_workload_hummingbird_datavolume_source }}
      secretRef: aws-s3-hummingbird-credentials
{% else %}
    http:
      url: {{ ocp4_workload_hummingbird_datavolume_source }}
{% endif %}  
  storage:
    storageClassName: {{ ocp4_workload_hummingbird_datavolume_storage_class_name }}
    resources:
      requests:
        storage: {{ ocp4_workload_hummingbird_datavolume_disksize }}
