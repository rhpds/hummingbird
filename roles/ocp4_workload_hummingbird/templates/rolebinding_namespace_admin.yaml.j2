---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: hummingbird-builds-namespace-admin
  namespace: {{ _ocp4_workload_hummingbird_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: admin
subjects:
- apiGroup: rbac.authorization.k8s.io
  kind: User
  name: {{ ocp4_workload_hummingbird_user_base }}{{ item }}
