---
apiVersion: v1
kind: Service
metadata:
  name: {{ ocp4_workload_hummingbird_tenant_vm_name }}
  namespace: {{ ocp4_workload_hummingbird_tenant_vm_namespace }}
spec:
  ports:
  - name: http
    port: 8080
    protocol: TCP
    targetPort: 8080
  selector:
    vm.kubevirt.io/name: {{ ocp4_workload_hummingbird_tenant_vm_name }}
  sessionAffinity: None
  type: ClusterIP
  