---
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: {{ ocp4_workload_hummingbird_tenant_vm_name }}
  namespace: {{ ocp4_workload_hummingbird_tenant_vm_namespace }}
spec:
  dataVolumeTemplates:
  - metadata:
      name: {{ ocp4_workload_hummingbird_tenant_vm_name }}-volume
    spec:
      sourceRef:
        kind: DataSource
        name: {{ ocp4_workload_hummingbird_tenant_vm_datasource_name }}
        namespace: {{ ocp4_workload_hummingbird_tenant_vm_datasource_namespace }}
      storage:
        resources:
          requests:
            storage: {{ ocp4_workload_hummingbird_tenant_vm_disksize }}
  instancetype:
    kind: virtualmachineclusterinstancetype
    name: {{ ocp4_workload_hummingbird_tenant_vm_instancetype }}
  preference:
    kind: virtualmachineclusterpreference
    name: rhel.10
  runStrategy: Always
  template:
    metadata:
      labels:
        network.kubevirt.io/headlessService: headless
    spec:
      architecture: amd64
      domain:
        devices:
          disks:
          - bootOrder: 1
            name: rootdisk
          - disk:
              bus: virtio
            name: cloudinitdisk
        machine:
          type: pc-q35-rhel9.6.0
        resources: {}
      subdomain: headless
      volumes:
      - name: rootdisk
        dataVolume:
          name: {{ ocp4_workload_hummingbird_tenant_vm_name }}-volume
      - name: cloudinitdisk
        cloudInitNoCloud:
          userData: |
            #cloud-config
            chpasswd:
              expire: false
            ssh_pwauth: {{ ocp4_workload_hummingbird_tenant_vm_ssh_pwauth | bool }}
            password: {{ ocp4_workload_hummingbird_tenant_vm_password }}
            user: {{ ocp4_workload_hummingbird_tenant_vm_user }}
            runcmd:
            {% if ocp4_workload_hummingbird_tenant_vm_satellite_url | length > 0 %}
              - curl -k -o /tmp/katello-ca-consumer-latest.noarch.rpm https://{{ ocp4_workload_hummingbird_tenant_vm_satellite_url }}/pub/katello-ca-consumer-latest.noarch.rpm
              - rpm -Uvh /tmp/katello-ca-consumer-latest.noarch.rpm
              - |
                subscription-manager register \
                  --activationkey="{{ ocp4_workload_hummingbird_tenant_vm_satellite_activation_key }}" \
                  --org="{{ ocp4_workload_hummingbird_tenant_vm_satellite_org }}" \
                  --force
            {% endif %}
            {% if ocp4_workload_hummingbird_tenant_vm_init_script_url | length > 0 %}
              - curl -sL -o /tmp/init.sh {{ ocp4_workload_hummingbird_tenant_vm_init_script_url }}
              - chmod +x /tmp/init.sh
              - /tmp/init.sh
            {% endif %}
              - echo "Setup complete"
