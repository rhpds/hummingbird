---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: {{ ocp4_workload_hummingbird_tenant_vm_name }}
  namespace: {{ ocp4_workload_hummingbird_tenant_vm_namespace }}
spec:
  port:
    targetPort: http
  tls:
    insecureEdgeTerminationPolicy: Redirect
    termination: edge
  to:
    kind: Service
    name: {{ ocp4_workload_hummingbird_tenant_vm_name }}
    weight: 100
  wildcardPolicy: None
